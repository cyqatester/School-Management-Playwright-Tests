# Spring Boot direct: http://localhost:8080/
# Tomcat WAR: http://localhost:8080/school-management-system/
BASE_URL=http://localhost:8080/school-management-system/

# Optional dedicated E2E test account; do not use production credentials.
E2E_USERNAME=
E2E_PASSWORD=

# Adjust selectors to match the actual login page HTML.
LOGIN_USERNAME_SELECTOR=input[name="username"]
LOGIN_PASSWORD_SELECTOR=input[name="password"]
LOGIN_SUBMIT_SELECTOR=button[type="submit"]
EXPECTED_AFTER_LOGIN=
